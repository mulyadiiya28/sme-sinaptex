{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "POS-Sinaptex",
  "version": "0.1.0",
  "identifier": "id.sinaptex.pos",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "POS-Sinaptex",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "id-ID"
      },
      "nsis": {
        "languages": ["Indonesian", "English"],
        "installMode": "both"
      }
    }
  }
}
