{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=accounting.db"
  },
  "Backup": {
    "Directory": "backups",
    "MaxFileSizeBytes": 536870912,
    "RetentionCount": 10,
    "DrainTimeoutSeconds": 30
  }
}
