# Mode API: "mock" (data in-memory, default) atau "live" (engine C# Accounting Engine).
NEXT_PUBLIC_API_MODE=mock

# Base URL engine Accounting Engine (.NET 10).
# Default dev: http://localhost:5121 (dari backend/src/AccountingEngine.Api/Properties/launchSettings.json).
# Mode LAN (Mode A): http://<server-toko>:5121
NEXT_PUBLIC_API_BASE_URL=http://localhost:5121

# Id tenant ("business") pada engine — header X-Business-Id.
NEXT_PUBLIC_BUSINESS_ID=toko-utama

# Nama penyetuju untuk batch kasir (harus berbeda dari peminta; engine menolak keduanya sama).
NEXT_PUBLIC_ENGINE_APPROVER=pemilik

# Kode akun dari chart SAK EMKM hasil POST /api/accounts/seed (level 3 = postable).
NEXT_PUBLIC_ENGINE_KAS=1121
NEXT_PUBLIC_ENGINE_BANK=1111
NEXT_PUBLIC_ENGINE_PIUTANG=1200
NEXT_PUBLIC_ENGINE_PERSEDIAAN=1300
NEXT_PUBLIC_ENGINE_HUTANG=2101
NEXT_PUBLIC_ENGINE_PENDAPATAN=4000
NEXT_PUBLIC_ENGINE_HPP=5000
NEXT_PUBLIC_ENGINE_PAJAK=2402
NEXT_PUBLIC_ENGINE_BIAYA=6900
